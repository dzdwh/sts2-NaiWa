<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RitsuLibRoot Condition="'$(RitsuLibRoot)' == ''">$(MSBuildProjectDirectory)\..\..\dependencies\RitsuLib</RitsuLibRoot>
    <RitsuLibGameVersion Condition="'$(RitsuLibGameVersion)' == ''">0.111.0</RitsuLibGameVersion>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(MSBuildProjectDirectory)\..\..\dependencies\0.111.0</Sts2DataDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SmartFormat">
      <HintPath>$(Sts2DataDir)\SmartFormat.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="STS2-RitsuLib">
      <HintPath>$(RitsuLibRoot)\compat\$(RitsuLibGameVersion)\STS2-RitsuLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="STS2-RitsuLib.Runtime">
      <HintPath>$(RitsuLibRoot)\compat\$(RitsuLibGameVersion)\STS2-RitsuLib.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="STS2-RitsuLib.Shared">
      <HintPath>$(RitsuLibRoot)\shared\STS2-RitsuLib.Shared.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="STS2-RitsuLib.Settings">
      <HintPath>$(RitsuLibRoot)\shared\STS2-RitsuLib.Settings.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="STS2-RitsuLib.Ui">
      <HintPath>$(RitsuLibRoot)\shared\STS2-RitsuLib.Ui.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
