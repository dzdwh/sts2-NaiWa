[ext_resource type="VideoStream" uid="uid://c58c6mprdgxx1" path="res://video/char_select_nai_wa.ogv" id="1"]
[ext_resource type="AudioStream" path="res://video/char_select_bgm.ogg" id="2"]

[sub_resource type="GDScript" id="GDScript_bgm"]
script/source = "extends Control

var _player: VideoStreamPlayer
var _audio: AudioStreamPlayer
var _fading := false
var _fade_tween: Tween

func _ready():
	_player = get_node('VideoStreamPlayer')
	_audio = get_node('BGMPlayer')
	_player.finished.connect(_on_video_finish)
	visibility_changed.connect(_on_visibility_changed)
	_player.play()
	_audio.play()

func _on_video_finish():
	if _fading: return
	_fading = true
	_fade_tween = create_tween()
	_fade_tween.tween_property(_audio, 'volume_db', -40, 1.5)
	_fade_tween.tween_callback(_audio.stop)

func _on_visibility_changed():
	if not is_visible_in_tree():
		_stop_bgm()

func _exit_tree():
	_stop_bgm()

func _stop_bgm():
	if _fade_tween != null:
		_fade_tween.kill()
		_fade_tween = null
	if is_instance_valid(_audio):
		_audio.stop()
	_fading = false
"

