[sub_resource type="GDScript" id="GDScript_laugh"]
script/source = "extends Control

func _ready():
	var spine = get_node('Spine')
	if spine.has_method('get_animation_state'):
		spine.call('get_animation_state').call('set_animation', 'laugh', false)
	get_node('Audio').play()
	await get_tree().create_timer(5.0).timeout
	queue_free()
"

